# Trucking24Fit — Apache defaults for shared hosting
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  DirectoryIndex index.php index.html

  # Block sensitive folders
  RewriteRule ^submissions/ - [F,L]
  RewriteRule ^includes/ - [F,L]

  # Redirect .php page URLs to clean paths (hide .php from the address bar)
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+((?:about|services|equipment|industries|quote|contact|privacy|terms))\.php[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Clean URL → PHP file
  RewriteRule ^(about|services|equipment|industries|quote|contact|privacy|terms)/?$ $1.php [L,QSA]

  # Clean API endpoints (PHP hosting)
  RewriteRule ^api/(quote|contact)/?$ php-api/$1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
